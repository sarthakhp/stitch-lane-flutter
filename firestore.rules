rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global app config (e.g. the AI kill switch) — any signed-in user can
    // read it, but only server-side (Admin SDK) can write it. No client
    // write path exists or should ever be added here.
    match /app_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
