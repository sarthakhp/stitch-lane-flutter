<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Frosted translucent "glass": wallpaper shows through. Android widgets
         can't blur the wallpaper, so this is a semi-transparent fill + a soft
         light border to read as glass. -->
    <solid android:color="#40FFFFFF" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp" />
</shape>
